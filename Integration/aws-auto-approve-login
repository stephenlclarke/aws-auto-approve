#!/usr/bin/env bash
# USAGE: aws-auto-approve-login [--if-needed] PROFILE
# Start AWS CLI device sign-in and send only its authentication messages to the helper.
set -euo pipefail

STATUS_GREEN=''
STATUS_RESET=''
case "${SCRIPT_COLOUR:-auto}" in
    0|false|off) ;;
    *)
        if [[ -t 2 && -z "${NO_COLOR+x}" && "${TERM:-}" != dumb ]]; then
            STATUS_GREEN=$'\033[32m'
            STATUS_RESET=$'\033[0m'
        fi
        ;;
esac

# Report verified profile access without exposing identity or credential data.
report_session() {
    printf '%s[v] [%s] AWS session is ready%s\n' "$STATUS_GREEN" "$1" "$STATUS_RESET" >&2
}

# Show the supported sign-in modes.
usage() {
    printf 'Usage: %s [--if-needed] PROFILE\n' "$(basename "$0")"
    printf 'Sign in using AWS CLI and the native approval helper. Granted is not used.\n'
    printf 'Report each verified profile on stderr. Set SCRIPT_COLOUR=off or NO_COLOR to disable colour.\n'
}

# Own the CLI process so cancellation can stop its pending device-code request.
run_login() (
    local profile="$1" work aws_pid='' helper_result=0 cli_result=0
    work="$(mktemp -d)" || return 1

    # Remove only this invocation's private FIFO and stop its own child process.
    # shellcheck disable=SC2329 # Called by the EXIT trap.
    cleanup() {
        if [[ -n "$aws_pid" ]]; then
            kill "$aws_pid" 2>/dev/null || true
            wait "$aws_pid" 2>/dev/null || true
        fi
        rm -rf "$work"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    mkfifo "$work/authentication" || return 1
    # AWS CLI's Python output must reach the app while AWS is waiting for approval.
    PYTHONUNBUFFERED=1 AWS_PAGER='' aws sso login --use-device-code --no-browser --profile "$profile" >"$work/authentication" 2>&1 &
    aws_pid=$!
    exec 3<"$work/authentication" || return 1
    aws-auto-approve --stdin <&3 || helper_result=$?
    if [[ "$helper_result" -ne 0 ]]; then return "$helper_result"; fi
    # Drain the CLI's final message without closing its output pipe too early.
    cat <&3 >/dev/null || return 1
    wait "$aws_pid" || cli_result=$?
    aws_pid=''
    return "$cli_result"
)

# Validate arguments and preserve both sides of the authentication pipeline.
main() {
    local if_needed=false profile
    case "${1:-}" in
        --help|-h) usage; return 0 ;;
        --if-needed) if_needed=true; shift ;;
    esac
    if [[ $# -ne 1 || -z "$1" || "$1" == -* ]]; then usage >&2; return 2; fi
    profile="$1"
    command -v aws >/dev/null || { printf 'Install AWS CLI v2 first.\n' >&2; return 1; }
    command -v aws-auto-approve >/dev/null || { printf 'Install aws-auto-approve first.\n' >&2; return 1; }

    if "$if_needed" && AWS_PAGER='' aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
        report_session "$profile"
        return 0
    fi

    if ! run_login "$profile"; then
        printf 'AWS sign-in failed. Check the profile, network and any login window.\n' >&2
        return 1
    fi
    AWS_PAGER='' aws sts get-caller-identity --profile "$profile" >/dev/null || return $?
    report_session "$profile"
}

main "$@"
